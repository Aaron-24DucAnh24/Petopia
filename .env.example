# Credentials for the containers in docker-compose.yml.
# Copy to .env. These defaults are for local development only and match the
# templates in config/; if you change one here, change it there too.

# SQL Server (backend). Must be 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Petopia@Local123

# Redis (backend cache + chat Pub/Sub)
REDIS_PASSWORD=petopia-redis

# MinIO (backend file storage). Password must be 8+ chars.
MINIO_ROOT_USER=petopia
MINIO_ROOT_PASSWORD=petopia-minio

# MeiliSearch (backend search). Must be 16+ bytes.
MEILI_MASTER_KEY=petopia-meili-master-key

# MongoDB (chat)
MONGODB_USERNAME=petopia
MONGODB_PASSWORD=petopia-mongo
