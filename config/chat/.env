# JWT: must match Token:AccessTokenKey and Token:Issuer in backend/Petopia.API/appsettings.Development.json
JWT_SECRET=local-dev-access-token-key-change-me-0123456789abcdef
JWT_ISSUER=petopia.hcmut@gmail.com
JWT_ALGORITHM=HS256

# MongoDB: credentials must match MONGODB_USERNAME/MONGODB_PASSWORD in the umbrella .env
MONGODB_URL=mongodb://petopia:petopia-mongo@localhost:27017/?authSource=admin
MONGODB_DB_NAME=petopia_chat

# Redis: the same instance as the backend; password must match REDIS_PASSWORD in the umbrella .env
REDIS_URL=redis://:petopia-redis@localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:3000"]
