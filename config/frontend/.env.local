# Backend REST API (the /api suffix is required; SignalR strips it to reach /hubs/realtime)
NEXT_PUBLIC_API_ENDPOINT=http://127.0.0.1:9999/api

# Chat service (REST + WebSocket)
NEXT_PUBLIC_CHAT_API_ENDPOINT=http://127.0.0.1:8000

# CKEditor 5 license key; "GPL" works for local development
NEXT_PUBLIC_CKEDITOR_LICENSE=GPL
